diff --git a/source/ast/builtins/MathFuncs.cpp b/source/ast/builtins/MathFuncs.cpp
index 8ef960ce1..cf35cd13a 100644
--- a/source/ast/builtins/MathFuncs.cpp
+++ b/source/ast/builtins/MathFuncs.cpp
@@ -37,8 +37,11 @@ public:
         if (!v)
             return nullptr;
 
-        auto ci = v.integer();
-        ci.flattenUnknowns();
+        // An argument with an x or z bit has no logarithm: the result is all x, as it is
+        // at run time (IEEE 1800-2023 20.8.1 does not say).
+        const auto& ci = v.integer();
+        if (ci.hasUnknown())
+            return SVInt::createFillX(32, true);
         return SVInt(32, clog2(ci), true);
     }
 };
