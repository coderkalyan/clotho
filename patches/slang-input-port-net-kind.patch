+TEST_CASE("Port kind of an input port that declares a data type") {
+    auto tree = SyntaxTree::fromText(R"(
+// [23.2.2.3]: "If the port kind is omitted: For input and inout ports, the port
+// shall default to a net of default net type." Applied wherever [6.7.1] permits
+// the data type to be a net's, which is what the inout direction already did.
+module m0 (input logic [3:0] a); endmodule
+module m1 (input reg a); endmodule
+module m2 (input integer a); endmodule
+module m3 (input time a); endmodule
+module m4 (input logic a, b); endmodule
+
+// A two-state type is not a valid data type for a net ([6.7.1]), so applying the
+// rule literally would reject these -- and slang has always accepted them.
+// They stay variables.
+module m5 (input int a); endmodule
+module m6 (input bit [3:0] a); endmodule
+module m7 (input real a); endmodule
+
+// Untouched by the rule: an explicit var, an output that declares a data type,
+// and ref, which is always a variable.
+module m8 (input var logic a); endmodule
+module m9 (output logic [3:0] a); endmodule
+module m10(ref logic a); endmodule
+
+// A named type is conservatively left a variable: the port's kind is decided
+// before its type is resolved.
+typedef logic [3:0] nibble_t;
+module m11(input nibble_t a); endmodule
+
+// Non-ANSI I/O declarations follow the same rule. `inout logic` used to become a
+// variable and was then rejected as a variable port with an inout direction.
+module m12(a, b, c);
+    input logic [3:0] a;
+    inout logic [3:0] b;
+    output logic [3:0] c;
+endmodule
+)");
+
+    Compilation compilation;
+    compilation.addSyntaxTree(tree);
+    NO_COMPILATION_ERRORS;
+
+    auto portKind = [&](std::string_view moduleName, std::string_view portName) {
+        auto def = compilation.getRoot().find(moduleName);
+        REQUIRE(def);
+        auto port = def->as<InstanceSymbol>().body.findPort(portName);
+        REQUIRE(port);
+        auto internal = port->as<PortSymbol>().internalSymbol;
+        REQUIRE(internal);
+        return internal->kind;
+    };
+
+    CHECK(portKind("m0"sv, "a"sv) == SymbolKind::Net);
+    CHECK(portKind("m1"sv, "a"sv) == SymbolKind::Net);
+    CHECK(portKind("m2"sv, "a"sv) == SymbolKind::Net);
+    CHECK(portKind("m3"sv, "a"sv) == SymbolKind::Net);
+    CHECK(portKind("m4"sv, "a"sv) == SymbolKind::Net);
+    CHECK(portKind("m4"sv, "b"sv) == SymbolKind::Net);
+
+    CHECK(portKind("m5"sv, "a"sv) == SymbolKind::Variable);
+    CHECK(portKind("m6"sv, "a"sv) == SymbolKind::Variable);
+    CHECK(portKind("m7"sv, "a"sv) == SymbolKind::Variable);
+
+    CHECK(portKind("m8"sv, "a"sv) == SymbolKind::Variable);
+    CHECK(portKind("m9"sv, "a"sv) == SymbolKind::Variable);
+    CHECK(portKind("m10"sv, "a"sv) == SymbolKind::Variable);
+    CHECK(portKind("m11"sv, "a"sv) == SymbolKind::Variable);
+
+    CHECK(portKind("m12"sv, "a"sv) == SymbolKind::Net);
+    CHECK(portKind("m12"sv, "b"sv) == SymbolKind::Net);
+    CHECK(portKind("m12"sv, "c"sv) == SymbolKind::Variable);
+}
