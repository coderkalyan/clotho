+// Whether a value of this type is, or streams through, a class handle: an unpacked
+// struct, union or array of any kind with one among its members or elements. Streaming
+// a non-null handle walks the object it refers to and skips a null one (IEEE 1800-2023
+// 11.4.14.1), so such a value has as many bits as the objects have, which no type fixes.
+static bool streamsClassHandle(const Type& type) {
+    auto& ct = type.getCanonicalType();
+    if (ct.isClass())
+        return true;
+
+    if (ct.isUnpackedArray())
+        return streamsClassHandle(*ct.getArrayElementType());
+
+    if (ct.isUnpackedStruct()) {
+        for (auto field : ct.as<UnpackedStructType>().fields) {
+            if (streamsClassHandle(field->getType()))
+                return true;
+        }
+    }
+    else if (ct.isUnpackedUnion()) {
+        for (auto field : ct.as<UnpackedUnionType>().fields) {
+            if (streamsClassHandle(field->getType()))
+                return true;
+        }
+    }
+    return false;
+}
