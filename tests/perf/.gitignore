# Fetched benchmark sources (pinned clones, see cases/*/fetch.sh).
cases/*/src/
# Generated synthetic designs (regenerated by cases/*/fetch.sh from gen.py).
cases/*/design.sv
# Hand-written case sources (no fetch.sh; the design.sv IS the source).
!cases/str_append/design.sv
!cases/nba_arr/design.sv
!cases/wide_mul/design.sv
# Per-run results; only baseline.json and oracles.json are checked in.
results.json
# Oracle tool build artifacts (runs execute in the case directory).
cases/*/iv.out
cases/*/obj_dir/
cases/*/*.log
cases/*/*.vcd
cases/*/splits.txt
cases/*/hyperfine.json
__pycache__/
# Machine-local oracle tool bindirs (install-specific paths).
tools.local.json
