{
  "_comment": "Copy to tools.local.json (gitignored). Maps an oracle tool to the bindir prepended to PATH for that tool's commands. Only needed for a tool that is not on the system PATH, e.g. a locally built iverilog or verilator; omit any tool the shell already resolves.",
  "iverilog": "/opt/iverilog/bin",
  "verilator": "/opt/verilator/bin"
}
